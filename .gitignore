# Archivos de configuración local (SECRETOS)
.env
*.json
!pos/data/sample_*.json

# Certificados AFIP/ARCA (nunca subir)
*.crt
*.key
*.pem
*.p12
*.pfx
certificados/*
!certificados/README.txt
sergiocrt.crt
sergiokey.key

# Streamlit: permitir config.toml, ignorar secretos locales
.streamlit/*
!.streamlit/config.toml

# Carpetas temporales de Python
__pycache__/
*.pyc
.venv/

# Archivos del sistema
.DS_Store
Thumbs.db
